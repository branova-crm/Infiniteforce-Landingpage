---
import { site } from '../config/site';
import { resolveLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';

interface Props {
  locale?: Locale;
}

const copy = getHome(resolveLocale(Astro.props.locale));
---

<!-- Mobile: Sticky-Leiste -->
<div
  data-sticky-cta
  class="sticky-bar fixed inset-x-0 bottom-0 z-70 border-t border-gold/30 px-4 pt-3 pb-[calc(12px+env(safe-area-inset-bottom))] md:hidden"
  hidden
>
  <div class="mx-auto flex max-w-[560px] items-center justify-between gap-4">
    <div class="min-w-0 leading-tight">
      <p class="font-display text-[17px] text-ivory">{copy.sticky.label}</p>
      <p class="mt-1 text-[11px] tracking-[0.08em] text-gold">{copy.sticky.meta}</p>
    </div>
    <a href={site.shopUrl} class="btn btn-gold min-h-[46px]! shrink-0 px-5!">{copy.sticky.cta}</a>
  </div>
</div>

<!-- Desktop: schwebender Link zum Angebot -->
<a
  data-float-cta
  href="#offer"
  class="btn btn-gold fixed right-6 bottom-6 z-70 hidden shadow-[0_18px_40px_-12px_rgba(0,0,0,0.6)] md:inline-flex"
  hidden
>
  {copy.sticky.float}
</a>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const floatBtn = document.querySelector<HTMLElement>('[data-float-cta]');
  const heroCta = document.querySelector<HTMLElement>('[data-hero-cta]');
  const offer = document.getElementById('offer');

  if (heroCta) {
    let frame = 0;

    const update = () => {
      frame = 0;
      const pastHero = heroCta.getBoundingClientRect().bottom < 0;
      const offerRect = offer?.getBoundingClientRect();
      const offerVisible = !!offerRect && offerRect.top < window.innerHeight && offerRect.bottom > 0;
      const show = pastHero && !offerVisible;
      const mobile = window.innerWidth < 768;
      if (bar) bar.hidden = !(show && mobile);
      if (floatBtn) floatBtn.hidden = !(show && !mobile);
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>
