---
import CtaButton from './CtaButton.astro';
import { webinar } from '../config/webinar';
import { resolveLocale, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale);
const copy = getUi(locale);
const { offer } = webinar;
---

<section id="first-movers" aria-labelledby="fm-title" class="offer-bg relative px-5 py-[clamp(52px,7vw,104px)]">
  <div class="mx-auto flex max-w-[1040px] flex-wrap items-center gap-[clamp(28px,5vw,72px)]">
    <div class="min-w-0 flex-[1_1_340px]">
      <p class="m-0 mb-3 text-[12px] font-extrabold tracking-[0.18em] text-primary-text uppercase">{copy.offerEyebrow}</p>
      <h2 id="fm-title" class="m-0 mb-4 text-[length:clamp(30px,3.8vw,48px)] leading-[1.04] font-black tracking-[-0.02em] text-balance text-ink uppercase">
        {copy.offerTitleBefore}{' '}
        <span class="text-primary-text">{copy.offerTitleAccent}</span>
      </h2>
      <p class="m-0 mb-[22px] max-w-[480px] text-[16px] leading-[1.6] text-pretty text-body">{copy.offerBody}</p>
      <p class="m-0 font-serif text-[length:clamp(24px,2.6vw,32px)] leading-[1.2] text-balance text-primary-text italic">{copy.offerQuote}</p>
    </div>

    <div class="mx-auto min-w-0 max-w-[480px] flex-[1_1_360px]">
      <div class="relative overflow-hidden rounded-card border border-primary-deep/40 bg-white p-[clamp(26px,4vw,40px)] text-center text-ink shadow-[0_8px_28px_rgba(74,63,48,0.08)]">
        <div aria-hidden="true" class="gold-hairline absolute top-0 right-[12%] left-[12%] h-0.5"></div>
        <p class="m-0 mb-3.5"><span class="gold-fill gold-text-shadow inline-block rounded-full px-4 py-[7px] text-[12px] font-black tracking-[0.12em] uppercase">First Movers</span></p>
        <h3 class="m-0 mb-2 text-[length:clamp(20px,2.4vw,24px)] leading-[1.2] font-black tracking-[0.02em] uppercase">{offer.name}</h3>
        <p class="m-0 mb-[22px] text-[13px] leading-[1.5] font-semibold text-body">{copy.offerProgramStart} <span class="font-bold text-ink">{offer.programStart}</span></p>
        <p class="m-0 mb-[18px] flex flex-wrap items-baseline justify-center gap-x-2.5 gap-y-1 border-b border-primary/25 pb-[18px]"><span class="text-[13px] font-semibold text-body">{copy.offerRegular}</span><span class="text-[20px] font-bold text-body line-through">{offer.regularPrice}</span></p>
        <p class="m-0 mb-2 text-[11px] font-extrabold tracking-[0.16em] text-primary-text uppercase">{copy.offerFirstMovers}</p>
        <p class="m-0 mb-[18px] text-[length:clamp(46px,6vw,64px)] leading-none font-black tracking-[-0.02em]">{offer.firstMoverPrice}</p>
        <p class="m-0 mb-6"><span class="inline-block rounded-input border border-primary-deep/35 bg-primary/15 px-3.5 py-[9px] text-[12px] leading-[1.4] font-extrabold tracking-[0.1em] text-balance text-primary-text uppercase">{offer.advantage}</span></p>
        <CtaButton label={copy.ctaOffer} class="box-border block px-5 py-[19px] text-center text-[16px] leading-[1.3] text-balance" />
        <p class="m-0 mt-3.5 text-[12px] leading-[1.5] text-body">{copy.offerConditions} {offer.conditions}</p>
      </div>
    </div>
  </div>
</section>
