---
/**
 * Weiche Seidenbewegung für den Seitenhintergrund.
 * Abgeleitet vom Silk-Canvas, aber ohne Demo-Typo und in dunklen
 * Grautönen. Läuft nativ in Astro – kein React nötig.
 */
---

<div class="silk-bg" aria-hidden="true">
  <canvas data-silk-canvas class="silk-bg__canvas"></canvas>
  <div class="silk-bg__overlay"></div>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-silk-canvas]');
  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: false });
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let frame = 0;
    let time = 0;
    let running = true;

    const speed = 0.038;
    const scale = 2.1;
    const noiseIntensity = 0.55;

    const noise = (x: number, y: number) => {
      const G = 2.71828;
      const rx = G * Math.sin(G * x);
      const ry = G * Math.sin(G * y);
      return (rx * ry * (1 + x)) % 1;
    };

    const sizeCanvas = () => {
      const ratio = 0.5;
      const width = Math.max(320, Math.floor(window.innerWidth * ratio));
      const height = Math.max(240, Math.floor(window.innerHeight * ratio));
      if (canvas.width === width && canvas.height === height) return;
      canvas.width = width;
      canvas.height = height;
    };

    const paint = () => {
      if (!ctx) return;
      const { width, height } = canvas;
      const imageData = ctx.createImageData(width, height);
      const data = imageData.data;
      const tOffset = speed * time;

      for (let y = 0; y < height; y += 1) {
        for (let x = 0; x < width; x += 1) {
          const u = (x / width) * scale;
          const v = (y / height) * scale;
          const texX = u;
          const texY = v + 0.06 * Math.sin(8 * texX - tOffset);

          const pattern =
            0.48 +
            0.52 *
              Math.sin(
                5 * (texX + texY + Math.cos(3 * texX + 5 * texY) + 0.028 * tOffset) +
                  Math.sin(18 * (texX + texY - 0.14 * tOffset)),
              );

          const intensity = Math.min(1, Math.max(0.18, pattern - (noise(x, y) / 14) * noiseIntensity));
          const index = (y * width + x) * 4;

          // Dunkle Seide in Graustufen (schwarz, kein Braun)
          const tone = Math.floor(8 + 72 * intensity);
          data[index] = tone;
          data[index + 1] = tone;
          data[index + 2] = tone;
          data[index + 3] = 255;
        }
      }

      ctx.putImageData(imageData, 0, 0);
    };

    const tick = () => {
      if (!running) return;
      paint();
      time += 1;
      if (!reduced) frame = requestAnimationFrame(tick);
    };

    sizeCanvas();
    tick();

    let resizeTimer = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        sizeCanvas();
        if (reduced) paint();
      }, 160);
    };

    window.addEventListener('resize', onResize);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        running = false;
        cancelAnimationFrame(frame);
        return;
      }
      if (!reduced && !running) {
        running = true;
        tick();
      }
    });
  }
</script>

<style>
  .silk-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: #050505;
  }

  .silk-bg__canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0.9;
    filter: blur(2px);
  }

  .silk-bg__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.32) 0%, rgba(0, 0, 0, 0.4) 45%, rgba(0, 0, 0, 0.55) 100%),
      radial-gradient(ellipse 70% 55% at 50% 0%, rgba(0, 0, 0, 0.15), transparent 70%);
  }
</style>
