---
import type { StoryCopy } from '../../i18n/home';
import { site } from '../../config/site';

interface Props {
  items: StoryCopy[];
  playLabel: string;
  class?: string;
}

const { items, playLabel, class: className } = Astro.props;
const mediaBySlug = Object.fromEntries(site.media.testimonials.map((t) => [t.slug, t]));
---

<div class:list={['vt-grid', className]}>
  {
    items.map((item, i) => {
      const media = mediaBySlug[item.slug];
      return (
        <article class="vt-card" data-vt-card>
          <button type="button" class="vt-card__media" data-vt-open aria-label={`${playLabel}: ${item.name}`}>
            <video
              data-vt-video
              class="vt-card__video"
              playsinline
              preload="none"
              poster={media?.poster}
              src={media?.video}
            />
            <span class="vt-card__play" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
          </button>
          <div class="vt-card__body">
            <p class="vt-card__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="vt-card__name">{item.name}</h3>
            <p class="vt-card__role">{item.role}</p>
            <p class="vt-card__quote">„{item.quote}“</p>
          </div>
        </article>
      );
    })
  }
</div>

<style>
  .vt-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .vt-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(29, 22, 17, 0.08);
    background: #ffffff;
    box-shadow: 0 12px 28px -22px rgba(29, 22, 17, 0.28);
  }

  @media (min-width: 640px) {
    .vt-grid {
      gap: 16px;
    }
  }

  @media (min-width: 900px) {
    .vt-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
  }

  .vt-card__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: #ece6dc;
    cursor: pointer;
  }

  /* 9:16-Quellen → 3:4-Crop über die Safe Zones (oben/unten mittig weg) */
  .vt-card__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    background: #e7dccb;
  }

  .vt-card__play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--if-espresso);
    box-shadow: 0 10px 28px -12px rgba(13, 10, 8, 0.45);
    transform: translate(-50%, -50%);
    transition:
      background 0.25s,
      color 0.25s,
      transform 0.25s var(--if-ease);
  }

  @media (min-width: 640px) {
    .vt-card__play {
      width: 58px;
      height: 58px;
    }
  }

  .vt-card__media:hover .vt-card__play {
    background: var(--if-gold);
    color: var(--if-espresso);
    transform: translate(-50%, -50%) scale(1.06);
  }

  .vt-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 12px 10px 14px;
    text-align: center;
    background: #ffffff;
  }

  @media (min-width: 640px) {
    .vt-card__body {
      padding: 20px 18px 22px;
    }
  }

  .vt-card__no {
    margin: 0;
    font-family: var(--if-font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--if-gold-ink);
  }

  .vt-card__name {
    margin: 6px 0 0;
    font-family: var(--if-font-headline);
    font-size: clamp(14px, 3.8vw, 22px);
    font-weight: 800;
    line-height: 1.15;
    color: var(--if-ink);
  }

  .vt-card__role {
    margin: 6px 0 0;
    font-family: var(--if-font-sans);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--if-ink-soft);
  }

  .vt-card__quote {
    margin: 8px 0 0;
    font-family: var(--if-font-sans);
    font-size: clamp(12px, 3.2vw, 14px);
    font-weight: 400;
    font-style: normal;
    line-height: 1.45;
    color: var(--if-ink-soft);
  }

  .vt-card.is-playing .vt-card__play {
    display: none;
  }
</style>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-vt-card]'));
  cards.forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>('[data-vt-open]');
    const video = card.querySelector<HTMLVideoElement>('[data-vt-video]');
    if (!btn || !video) return;

    btn.addEventListener('click', async () => {
      cards.forEach((other) => {
        if (other === card) return;
        other.classList.remove('is-playing');
        const v = other.querySelector<HTMLVideoElement>('[data-vt-video]');
        if (v) {
          v.pause();
          v.controls = false;
        }
      });

      card.classList.add('is-playing');
      video.controls = true;
      try {
        video.muted = false;
        await video.play();
      } catch {
        /* Video fehlt oder Autoplay blockiert */
      }
    });

    video.addEventListener('ended', () => {
      card.classList.remove('is-playing');
      video.controls = false;
    });
  });
</script>
