---
import CtaButton from '../CtaButton.astro';
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const copy = getHome(resolveLocale(Astro.props.locale));
---

<div class="ei" data-exit-intent hidden>
  <div class="ei__backdrop" data-ei-close></div>
  <div class="ei__panel grain" role="dialog" aria-modal="true" aria-labelledby="ei-title">
    <button type="button" class="ei__x" data-ei-close aria-label={copy.exit.close}>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.2"></path>
      </svg>
    </button>
    <p class="eyebrow eyebrow--ink">{copy.exit.eyebrow}</p>
    <h2 id="ei-title" class="display mt-5 text-[34px] text-ink">{copy.exit.title}</h2>
    <p class="body-copy mt-4 text-ink-soft">{copy.exit.text}</p>
    <div class="mt-8 grid gap-3">
      <CtaButton label={copy.exit.cta} block />
      <a href="#questions" class="btn btn-ghost-ink btn-block" data-ei-close>{copy.exit.secondary}</a>
    </div>
  </div>
</div>

<style>
  .ei {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 20px;
  }

  .ei[hidden] {
    display: none;
  }

  .ei__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 6, 4, 0.72);
  }

  .ei__panel {
    position: relative;
    z-index: 1;
    width: min(460px, 100%);
    padding: 44px 36px 36px;
    border: 1px solid rgba(160, 124, 69, 0.4);
    border-radius: 2px;
    background: var(--if-ivory);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }

  .ei__x {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--if-ink-soft);
    cursor: pointer;
  }

  .ei__x:hover {
    color: var(--if-ink);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-exit-intent]');
  if (root) {
    const key = 'if-exit-shown';
    let shown = sessionStorage.getItem(key) === '1';

    const open = () => {
      if (shown) return;
      shown = true;
      sessionStorage.setItem(key, '1');
      root.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      root.querySelector<HTMLElement>('[data-ei-close].ei__x')?.focus();
    };

    const close = () => {
      root.hidden = true;
      document.documentElement.style.overflow = '';
    };

    root.querySelectorAll('[data-ei-close]').forEach((el) => {
      el.addEventListener('click', close);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !root.hidden) close();
    });

    document.addEventListener('mouseout', (event) => {
      const e = event as MouseEvent;
      if (!e.relatedTarget && e.clientY <= 0) open();
    });

    let armed = false;
    window.addEventListener(
      'scroll',
      () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        if (max > 0 && window.scrollY / max > 0.45) armed = true;
      },
      { passive: true },
    );
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden' && armed) open();
    });
  }
</script>
