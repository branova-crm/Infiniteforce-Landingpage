---
interface Props {
  status: 'sent' | 'delivered' | 'read';
}

const { status } = Astro.props;
---

<svg
  class:list={['wa-tick', status === 'read' && 'wa-tick--read']}
  width="17"
  height="11"
  viewBox="0 0 17 11"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    status === 'sent' ? (
      <path d="M1.5 6l3 3L11 2" />
    ) : (
      <>
        <path d="M1 6l3 3L10.5 2" />
        <path d="M7.5 8.6L8 9l6.5-7" />
      </>
    )
  }
</svg>
