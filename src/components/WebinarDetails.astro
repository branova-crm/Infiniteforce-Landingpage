---
import { webinar } from '../config/webinar';
import { resolveLocale, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';

interface Props {
  cellClass: string;
  labelClass?: string;
  class?: string;
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale);
const copy = getUi(locale);
const { cellClass, labelClass = 'text-primary', class: className } = Astro.props;

const items = [
  { label: copy.detailsDate, value: webinar.date },
  { label: copy.detailsTime, value: webinar.time },
];
---

<dl class:list={['m-0 grid grid-cols-2 gap-px overflow-hidden rounded-tile border border-primary/22 bg-primary/22', className]}>
  {
    items.map((item) => (
      <div class:list={['min-w-0 px-4 py-3', cellClass]}>
        <dt class:list={['mb-1 text-[10.5px] font-extrabold tracking-[0.16em] uppercase', labelClass]}>{item.label}</dt>
        <dd class="m-0 text-[15px] font-bold [overflow-wrap:anywhere]">{item.value}</dd>
      </div>
    ))
  }
</dl>
