---
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { program } = getHome(resolveLocale(Astro.props.locale));
---

<section id="program" class="surface-dark section-pad" aria-labelledby="program-title">
  <div class="container-x">
    <div class="max-w-[52rem]" data-reveal>
      <p class="eyebrow">{program.eyebrow}</p>
      <h2 id="program-title" class="display mt-8 text-[clamp(32px,5vw,72px)] text-ivory">{program.title}</h2>
      <p class="lead mt-6 max-w-[40rem] text-mist">{program.lead}</p>
    </div>

    <ol class="timeline mt-16" data-reveal style="--reveal-delay:100ms">
      {
        program.steps.map((step, i) => (
          <li class="timeline__item">
            <span class="timeline__dot" aria-hidden="true" />
            <div>
              <p class="label-caps text-[10px] text-gold">{String(i + 1).padStart(2, '0')}</p>
              <p class="display-italic gold-text mt-2 pb-1 text-[clamp(40px,4vw,56px)] leading-none">{step.word}</p>
              <p class="display mt-3 text-[17px] text-cream">{step.title}</p>
              <p class="mt-3 text-[14px] leading-relaxed text-mist">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-24 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6" data-reveal>
        <h3 class="display text-[clamp(36px,4.4vw,60px)] text-ivory">{program.goalTitle}</h3>
        <p class="display-italic mt-3 text-[clamp(22px,2.2vw,28px)] text-gold-light">{program.goalLead}</p>
        <ul class="mt-8">
          {
            program.goals.map((goal) => (
              <li class="flex gap-4 border-b border-gold/15 py-4 text-[16px] text-ivory">
                <span class="text-[9px] leading-[2.6] text-gold" aria-hidden="true">◆</span>
                {goal}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card-dark p-[clamp(26px,4vw,48px)] lg:col-span-6" data-reveal style="--reveal-delay:100ms">
        <p class="body-copy text-mist line-through decoration-1">{program.questionFrom}</p>
        <p class="display-italic mt-4 text-[clamp(26px,3vw,38px)] leading-tight text-cream">{program.questionTo}</p>
        <div class="hairline my-8"></div>
        <p class="label-caps text-gold">{program.shiftTitle}</p>
        <ul class="mt-5 space-y-3">
          {program.shifts.map((s) => <li class="font-display text-[clamp(19px,1.8vw,23px)] text-ivory">{s}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 36px;
    padding-left: 34px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 6px;
    width: 1px;
    background: linear-gradient(180deg, rgba(200, 164, 110, 0.7), rgba(200, 164, 110, 0.15));
  }

  .timeline__item {
    position: relative;
  }

  .timeline__dot {
    position: absolute;
    top: 3px;
    left: -34px;
    width: 13px;
    height: 13px;
    border: 1px solid var(--if-gold);
    border-radius: 999px;
    background: var(--if-black);
  }

  .timeline__dot::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 999px;
    background: var(--if-gold);
  }

  @media (min-width: 1024px) {
    .timeline {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 28px;
      padding-left: 0;
      padding-top: 40px;
    }

    .timeline::before {
      top: 6px;
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, rgba(200, 164, 110, 0.15), rgba(200, 164, 110, 0.7), rgba(200, 164, 110, 0.15));
    }

    .timeline__dot {
      top: -40px;
      left: 0;
    }
  }
</style>
