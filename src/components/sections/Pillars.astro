---
import CtaButton from '../CtaButton.astro';
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { pillars } = getHome(resolveLocale(Astro.props.locale));
---

<section class="surface-cocoa section-pad" aria-labelledby="pillars-title">
  <div class="container-x">
    <div class="max-w-[48rem]" data-reveal>
      <p class="eyebrow">{pillars.eyebrow}</p>
      <h2 id="pillars-title" class="display mt-8 text-[clamp(34px,4.6vw,64px)] text-ivory">{pillars.title}</h2>
    </div>

    <div class="mt-16 grid gap-px bg-gold/20 lg:grid-cols-3">
      {
        pillars.items.map((pillar, i) => (
          <article class="pillar bg-cocoa p-[clamp(26px,3vw,40px)]" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <p class="font-display text-[15px] text-gold italic">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="display-italic gold-text mt-4 pb-1 text-[clamp(38px,4vw,54px)] leading-none">{pillar.word}</h3>
            <p class="display mt-5 text-[clamp(18px,1.6vw,21px)] leading-snug text-cream">{pillar.title}</p>
            <p class="label-caps mt-5 text-[10px] leading-relaxed text-gold">{pillar.focus}</p>
            <div class="hairline mt-6"></div>
            <div class="mt-6 space-y-4">
              {pillar.paragraphs.map((p) => (
                <p class="body-copy text-mist">{p}</p>
              ))}
            </div>
            {pillar.pairs && (
              <ul class="mt-7 space-y-5">
                {pillar.pairs.map((pair) => (
                  <li>
                    <p class="text-[14px] text-ivory/45 line-through decoration-1">{pair.stop}</p>
                    <p class="mt-1 flex gap-2 text-[15px] text-ivory">
                      <span class="text-gold" aria-hidden="true">→</span>
                      {pair.start}
                    </p>
                  </li>
                ))}
              </ul>
            )}
            {pillar.closing && <p class="display-italic mt-7 text-[21px] leading-snug text-gold-light">{pillar.closing}</p>}
          </article>
        ))
      }
    </div>

    <ul class="mt-16 grid grid-cols-2 border border-gold/25 lg:grid-cols-4" data-reveal>
      {
        pillars.cross.map((item, i) => (
          <li
            class:list={[
              'display px-4 py-7 text-center text-[clamp(17px,1.8vw,24px)] text-ivory',
              i % 2 === 1 && 'border-l border-gold/25',
              i >= 2 && 'border-t border-gold/25 lg:border-t-0',
              i === 2 && 'lg:border-l',
            ]}
          >
            {item}
          </li>
        ))
      }
    </ul>

    <div class="mt-14 flex flex-col items-center gap-6 text-center" data-reveal>
      {pillars.crossText.map((t) => <p class="display-italic text-[clamp(26px,3vw,40px)] text-cream">{t}</p>)}
      <CtaButton label={pillars.cta} />
    </div>
  </div>
</section>
