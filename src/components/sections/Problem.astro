---
import ChatMock from '../ui/ChatMock.astro';
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { problem, chatUi } = getHome(resolveLocale(Astro.props.locale));
---

<section id="problem" class="surface-cocoa grain section-pad" aria-labelledby="problem-title" data-section="problem">
  <div class="container-x">
    <div class="mx-auto max-w-[46rem] text-center" data-reveal>
      <p class="eyebrow eyebrow--center">{problem.eyebrow}</p>
      <h2 id="problem-title" class="headline mt-6 text-[clamp(30px,4.2vw,52px)] leading-[1.12]">
        {problem.title}
      </h2>
      <p class="lead mx-auto mt-5 max-w-[36rem] text-mist">{problem.titleAccent}</p>
    </div>

    <div class="problem-grid mt-14 md:mt-16" data-chat-group>
      {
        problem.chats.map((scene, i) => (
          <article class="problem-card" data-chat-card>
            <ChatMock scene={scene} ui={chatUi} hideLabel composer={false} grouped />
            <div class="problem-card__body">
              <p class="problem-card__no">{String(i + 1).padStart(2, '0')}</p>
              <h3>{problem.cards[i].title}</h3>
              <p>{problem.cards[i].text}</p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="problem-closing" data-reveal>
      {
        problem.closing.map((part) =>
          typeof part === 'string' ? part : <strong>{part.strong}</strong>,
        )
      }
    </p>
  </div>
</section>

<style>
  .problem-closing {
    max-width: 34rem;
    margin: 64px auto 0;
    font-family: var(--if-font-sans);
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 400;
    line-height: 1.45;
    text-align: center;
    text-wrap: balance;
    color: var(--if-mist);
  }

  .problem-closing strong {
    font-weight: 700;
    color: var(--if-ivory);
  }

  .problem-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    max-width: 440px;
    margin-inline: auto;
  }

  .problem-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 20px;
    background: var(--if-cream);
  }

  .problem-card :global(.chat) {
    margin: 0;
  }

  .problem-card :global(.wa) {
    border-radius: 20px 20px 0 0;
    box-shadow: none;
  }

  .problem-card :global(.wa__body) {
    min-height: 250px;
  }

  .problem-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px 22px 26px;
    background: #fff;
  }

  .problem-card__no {
    font-family: var(--if-font-headline);
    font-size: 15px;
    font-style: italic;
    font-weight: 800;
    color: var(--if-gold-ink);
  }

  .problem-card__no::after {
    content: '';
    display: inline-block;
    width: 36px;
    height: 1px;
    margin-left: 10px;
    vertical-align: middle;
    background: var(--if-gold-deep);
  }

  .problem-card__body h3 {
    margin-top: 10px;
    font-family: var(--if-font-headline);
    font-size: clamp(22px, 1.8vw, 26px);
    font-weight: 800;
    line-height: 1.2;
    color: var(--if-ink);
  }

  .problem-card__body p:last-child {
    margin-top: 10px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--if-ink-soft);
  }

  @media (min-width: 1024px) {
    .problem-grid {
      max-width: none;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>('[data-chat-group]');
  if (group) {
    const cards = Array.from(group.querySelectorAll<HTMLElement>('[data-chat-card]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const playCard = (card: HTMLElement) => {
      const chat = card.querySelector<HTMLElement>('[data-chat-mock]');
      chat?.dispatchEvent(new Event('chat:play'));
    };

    if (reduce || !('IntersectionObserver' in window)) {
      cards.forEach(playCard);
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const card = entry.target as HTMLElement;
            io.unobserve(card);
            playCard(card);
          }
        },
        {
          threshold: 0.35,
          rootMargin: '0px 0px -12% 0px',
        },
      );
      cards.forEach((card) => io.observe(card));
    }
  }
</script>
