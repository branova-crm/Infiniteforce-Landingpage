---
import CtaButton from '../CtaButton.astro';
import { site } from '../../config/site';
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { offer } = getHome(resolveLocale(Astro.props.locale));
const { card } = offer;
---

<section id="offer" class="surface-ivory grain section-pad on-light" aria-labelledby="offer-title">
  <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7" data-reveal>
      <p class="eyebrow">{offer.eyebrow}</p>
      <h2 id="offer-title" class="display mt-8 text-[clamp(42px,6vw,88px)] leading-[0.95] text-ink">{offer.title}</h2>
      <p class="display-italic mt-6 max-w-[30ch] text-[clamp(22px,2.3vw,30px)] leading-snug text-gold-ink">{offer.lead}</p>

      <p class="label-caps mt-14 text-ink">{offer.includedTitle}</p>
      <ul class="mt-6 grid gap-x-10 sm:grid-cols-2">
        {
          offer.included.map((item) => (
            <li class="flex gap-4 border-b border-ink/12 py-4 text-[15px] leading-snug text-ink">
              <svg class="mt-1 shrink-0 text-gold-deep" width="14" height="12" viewBox="0 0 14 12" aria-hidden="true">
                <path d="M1 6.5l4 4L13 1.5" fill="none" stroke="currentColor" stroke-width="1.3" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>

      <p class="label-caps mt-14 text-ink">{offer.trioTitle}</p>
      <ul class="mt-6 grid gap-px bg-ink/12 md:grid-cols-3">
        {
          offer.trio.map((item) => (
            <li class="bg-cream p-6">
              <p class="display-italic text-[28px] leading-none text-gold-ink">{item.word}</p>
              <p class="mt-3 text-[14px] leading-relaxed text-ink">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="lg:col-span-5" data-reveal style="--reveal-delay:120ms" aria-label={card.name}>
      <div class="offer-card lg:sticky lg:top-28">
        <div class="flex items-center justify-between gap-4">
          <span class="offer-card__badge">{card.badge}</span>
          <span class="label-caps text-[10px] text-mist">{card.product}</span>
        </div>

        <p class="display mt-8 text-[clamp(34px,3.4vw,46px)] leading-none text-ivory">{card.name}</p>
        <p class="mt-4 text-[13px] text-mist">
          {card.startLabel}: <span class="text-cream">{card.start}</span>
        </p>

        <div class="hairline my-8"></div>

        <div class="flex items-end justify-between gap-6">
          <div>
            <p class="label-caps text-[10px] text-mist">{card.priceLabel}</p>
            <p class="display gold-text mt-2 text-[clamp(52px,5vw,68px)] leading-none">{site.offer.firstMoverPrice}</p>
          </div>
          <div class="text-right">
            <p class="label-caps text-[10px] text-mist">{card.regularLabel}</p>
            <p class="mt-2 font-display text-[26px] text-ivory/50 line-through decoration-1">{site.offer.regularPrice}</p>
          </div>
        </div>

        <p class="offer-card__advantage mt-6">{card.advantage}</p>

        <CtaButton label={card.cta} block class="mt-8" />

        <ul class="mt-6 space-y-2">
          {
            card.trust.map((line) => (
              <li class="flex items-center gap-3 text-[12.5px] text-mist">
                <span class="h-px w-4 bg-gold" aria-hidden="true" />
                {line}
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-[12px] leading-relaxed text-ivory/50">{card.conditions}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  .offer-card {
    padding: clamp(26px, 3.4vw, 44px);
    border: 1px solid rgba(200, 164, 110, 0.4);
    background:
      radial-gradient(ellipse 90% 60% at 100% 0%, rgba(200, 164, 110, 0.2), transparent 60%),
      var(--if-espresso);
    color: var(--if-ivory);
    box-shadow: 0 40px 80px -40px rgba(29, 22, 17, 0.7);
  }

  .offer-card__badge {
    padding: 6px 12px;
    background: linear-gradient(135deg, #e0c592, #a98551);
    color: var(--if-espresso);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .offer-card__advantage {
    padding: 12px 16px;
    border: 1px dashed rgba(200, 164, 110, 0.5);
    color: var(--if-gold-light);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-align: center;
    text-transform: uppercase;
  }
</style>
