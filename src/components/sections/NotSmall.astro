---
import { Image } from 'astro:assets';
import patricia from '../../assets/images/patricia-baylan.jpg';
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { notSmall } = getHome(resolveLocale(Astro.props.locale));
---

<section class="surface-dark section-pad" aria-labelledby="notsmall-title">
  <div class="container-x grid items-start gap-16 lg:grid-cols-12 lg:gap-14">
    <figure class="frame-offset relative z-0 mx-auto w-full max-w-[420px] lg:sticky lg:top-28 lg:col-span-5" data-reveal>
      <Image
        src={patricia}
        alt={notSmall.imageAlt}
        widths={[400, 800]}
        sizes="(min-width: 1024px) 420px, 90vw"
        class="aspect-[4/5] h-auto w-full object-cover object-[50%_20%]"
      />
    </figure>

    <div class="lg:col-span-7" data-reveal style="--reveal-delay:100ms">
      <p class="eyebrow">{notSmall.eyebrow}</p>
      <h2 id="notsmall-title" class="display-italic mt-7 text-[clamp(40px,5.6vw,78px)] leading-[1.02] text-ivory">
        {notSmall.title}
      </h2>

      <div class="mt-10 max-w-[36rem] space-y-4">
        {notSmall.paragraphs.map((p) => <p class="lead text-mist">{p}</p>)}
      </div>

      <ul class="mt-10 border-y border-gold/20 py-6">
        {
          notSmall.loop.map((line) => (
            <li class="display py-1 text-[clamp(24px,3vw,38px)] text-ivory/35">{line}</li>
          ))
        }
      </ul>

      <div class="mt-10 max-w-[36rem] space-y-5">
        {notSmall.turn.map((p) => <p class="body-copy text-mist">{p}</p>)}
      </div>

      <div class="mt-14">
        <p class="display-italic max-w-[30ch] text-[clamp(22px,2.4vw,30px)] leading-snug text-cream">{notSmall.closingLead}</p>
        <p class="display gold-text mt-4 text-[clamp(72px,12vw,168px)] leading-[0.9]">{notSmall.closingAccent}</p>
      </div>
    </div>
  </div>
</section>
