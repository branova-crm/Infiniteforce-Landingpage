---
import Faq from '../ui/Faq.astro';
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { faq } = getHome(resolveLocale(Astro.props.locale));
---

<section id="faq" class="surface-cocoa section-pad" aria-labelledby="faq-title">
  <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4" data-reveal>
      <p class="eyebrow">{faq.eyebrow}</p>
      <h2 id="faq-title" class="display mt-8 text-[clamp(34px,4.2vw,58px)] text-ivory">{faq.title}</h2>
      <p class="body-copy mt-8 text-mist">{faq.contactText}</p>
      <a href="#questions" class="link-arrow mt-3 text-gold">{faq.contactCta} →</a>
    </div>
    <div class="lg:col-span-8" data-reveal style="--reveal-delay:100ms">
      <Faq items={faq.items} />
    </div>
  </div>
</section>
