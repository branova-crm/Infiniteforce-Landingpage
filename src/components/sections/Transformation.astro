---
import ChatMock from '../ui/ChatMock.astro';
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { transformation: tf, chatUi } = getHome(resolveLocale(Astro.props.locale));
---

<section class="surface-cream grain section-pad on-light" aria-labelledby="transformation-title">
  <div class="container-x">
    <div class="text-center" data-reveal>
      <p class="eyebrow eyebrow--center">{tf.eyebrow}</p>
      <h2 id="transformation-title" class="display mt-8 text-[clamp(38px,5.6vw,80px)] text-ink">{tf.title}</h2>
    </div>

    <div class="tf-compare relative mt-16 grid md:grid-cols-2" data-reveal>
      <span class="tf-compare__arrow" aria-hidden="true">→</span>
      <div class="p-[clamp(24px,4vw,52px)]">
        <p class="label-caps text-ink/50">{tf.beforeLabel}</p>
        <ul class="mt-6 space-y-5">
          {
            tf.before.map((line) => (
              <li class="flex gap-4 text-[15px] leading-relaxed text-ink/60">
                <svg class="mt-1.5 shrink-0" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1" />
                </svg>
                {line}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="tf-compare__after p-[clamp(24px,4vw,52px)]">
        <p class="label-caps text-gold">{tf.afterLabel}</p>
        <ul class="mt-6 space-y-5">
          {
            tf.after.map((line) => (
              <li class="flex gap-4 text-[15px] leading-relaxed text-ivory">
                <svg class="mt-1.5 shrink-0 text-gold" width="14" height="12" viewBox="0 0 14 12" aria-hidden="true">
                  <path d="M1 6.5l4 4L13 1.5" fill="none" stroke="currentColor" stroke-width="1.2" />
                </svg>
                {line}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-16 grid gap-10 md:grid-cols-2 md:gap-12" data-reveal>
      <ChatMock scene={tf.chatBefore} ui={chatUi} />
      <ChatMock scene={tf.chatAfter} ui={chatUi} highlight />
    </div>

    <div class="mt-20 text-center" data-reveal>
      <p class="label-caps text-gold-ink">{tf.measure}</p>
      <ul class="tf-outcomes mt-6">
        {tf.outcomes.map((o) => <li>{o}</li>)}
      </ul>
      <div class="mx-auto mt-12 max-w-[40rem]">
        <p class="lead text-ink">{tf.closing[0]}</p>
        <p class="display-italic mt-3 text-[clamp(26px,3vw,40px)] leading-tight text-gold-ink">{tf.closing[1]}</p>
      </div>
    </div>

    <div class="mt-24" data-reveal>
      <p class="display mx-auto max-w-[44rem] text-center text-[clamp(22px,2.4vw,32px)] text-ink">{tf.movesTitle}</p>
      <ul class="mt-12 grid gap-px bg-ink/12 sm:grid-cols-2 lg:grid-cols-3">
        {
          tf.moves.map((move) => (
            <li class="bg-cream p-6">
              <p class="text-[13px] tracking-[0.06em] text-ink/50 line-through decoration-1">{move.from}</p>
              <p class="mt-2 flex gap-3 font-display text-[22px] leading-snug text-ink">
                <span class="text-gold-ink" aria-hidden="true">→</span>
                {move.to}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .tf-compare {
    border: 1px solid rgba(29, 22, 17, 0.12);
    background: var(--if-ivory);
  }

  .tf-compare__after {
    background:
      radial-gradient(ellipse 80% 70% at 100% 0%, rgba(200, 164, 110, 0.18), transparent 60%),
      var(--if-espresso);
  }

  .tf-compare__arrow {
    display: none;
  }

  @media (min-width: 768px) {
    .tf-compare__arrow {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 1;
      display: grid;
      place-items: center;
      width: 52px;
      height: 52px;
      border: 1px solid var(--if-gold-deep);
      border-radius: 999px;
      background: var(--if-cream);
      color: var(--if-gold-ink);
      font-size: 20px;
      transform: translate(-50%, -50%);
    }
  }

  .tf-outcomes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .tf-outcomes li {
    padding: 10px 20px;
    border: 1px solid rgba(125, 95, 49, 0.35);
    font-family: var(--if-font-display);
    font-size: clamp(18px, 1.8vw, 22px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--if-ink);
  }
</style>
