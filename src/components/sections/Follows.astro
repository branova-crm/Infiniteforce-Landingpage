---
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { follows } = getHome(resolveLocale(Astro.props.locale));
---

<section class="surface-ivory grain section-pad on-light" aria-labelledby="follows-title">
  <div class="container-x">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start" data-reveal>
        <p class="eyebrow">{follows.eyebrow}</p>
        <h2 id="follows-title" class="display mt-8 text-[clamp(40px,5.4vw,76px)] text-ink">{follows.title}</h2>
        <ul class="mt-8 space-y-1">
          {
            follows.notList.map((line) => (
              <li class="display-italic text-[clamp(20px,2vw,26px)] text-ink/40 line-through decoration-1">{line}</li>
            ))
          }
        </ul>
        <p class="display mt-6 text-[clamp(80px,11vw,150px)] leading-[0.9] text-gold-ink">{follows.you}</p>
      </div>

      <div class="lg:col-span-7" data-reveal style="--reveal-delay:100ms">
        <ul class="border-t border-ink/15">
          {
            follows.youList.map((item) => (
              <li class="border-b border-ink/15 py-4 font-display text-[clamp(22px,2.4vw,32px)] leading-snug text-ink">{item}</li>
            ))
          }
        </ul>
        <div class="mt-10 space-y-3">
          {follows.paragraphs.map((p, i) => <p class:list={[i === 1 ? 'display text-[24px] text-ink' : 'lead']}>{p}</p>)}
        </div>
        <ol class="mt-10 space-y-4">
          {
            follows.chain.map((line, i) => (
              <li class="flex gap-5">
                <span class="mt-1 grid h-8 w-8 shrink-0 place-items-center rounded-full border border-gold-deep/60 font-display text-[15px] text-gold-ink">
                  {i + 1}
                </span>
                <span class="body-copy pt-1">{line}</span>
              </li>
            ))
          }
        </ol>
        <p class="display-italic mt-10 text-[clamp(26px,2.8vw,36px)] text-gold-ink">{follows.mantra}</p>
      </div>
    </div>

    <div class="follows__business mt-24 grid gap-10 p-[clamp(28px,5vw,64px)] lg:grid-cols-12" data-reveal>
      <h3 class="display text-[clamp(28px,3.4vw,46px)] text-ivory lg:col-span-5">{follows.businessTitle}</h3>
      <div class="lg:col-span-7">
        <ul class="space-y-3">
          {follows.businessChain.map((line) => <li class="body-copy text-mist">{line}</li>)}
        </ul>
        <div class="hairline my-8"></div>
        <p class="lead text-cream">{follows.businessEnd[0]}</p>
        <p class="body-copy mt-3 text-mist">{follows.businessEnd[1]}</p>
        <p class="display-italic gold-text mt-6 pb-1 text-[clamp(30px,3.4vw,46px)]">{follows.businessEnd[2]}</p>
      </div>
    </div>

    <div class="mt-24 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <h3 class="display text-[clamp(30px,3.8vw,52px)] text-ink">{follows.accountTitle}</h3>
        <p class="display-italic mt-6 text-[clamp(22px,2.2vw,28px)] text-gold-ink">{follows.accountLead}</p>
      </div>
      <ol class="grid gap-px bg-ink/12 sm:grid-cols-2 lg:col-span-7" data-reveal style="--reveal-delay:100ms">
        {
          follows.moments.map((m, i) => (
            <li class="bg-cream p-6">
              <span class="font-display text-[15px] text-gold-ink italic">{String(i + 1).padStart(2, '0')}</span>
              <p class="mt-3 text-[15px] leading-relaxed text-ink">… {m}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="mx-auto mt-20 max-w-[52rem] text-center" data-reveal>
      <p class="display text-[clamp(28px,3.4vw,46px)] text-ink">{follows.energyTitle}</p>
      <p class="body-copy mt-4 text-ink/55 line-through decoration-1">{follows.energyText[0]}</p>
      <p class="lead mt-2 text-ink">{follows.energyText[1]}</p>
      <p class="display-italic mt-8 text-[clamp(24px,2.6vw,32px)] text-gold-ink">{follows.mantra}</p>
      <ul class="mt-6 space-y-2">
        {follows.energyChain.map((line) => <li class="body-copy">{line}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .follows__business {
    background:
      radial-gradient(ellipse 70% 80% at 0% 100%, rgba(200, 164, 110, 0.16), transparent 60%),
      var(--if-espresso);
  }
</style>
