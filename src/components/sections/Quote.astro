---
import GoldEdgeGlow from '../ui/GoldEdgeGlow.astro';
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { stories } = getHome(resolveLocale(Astro.props.locale));
---

<section class="quote-section section-pad-sm on-light" aria-label={stories.quoteBy}>
  <GoldEdgeGlow />
  <div class="container-x relative z-10">
    <figure class="quote-section__inner mx-auto max-w-[40rem] text-center" data-reveal>
      <blockquote class="quote-section__text">{stories.quote}</blockquote>
      <figcaption class="quote-section__by">— {stories.quoteBy}</figcaption>
    </figure>
  </div>
</section>

<style>
  .quote-section {
    position: relative;
    overflow: hidden;
    background: #f7f1e6;
  }

  .quote-section__text {
    margin: 0;
    font-family: var(--if-font-sans);
    font-size: clamp(17px, 1.7vw, 21px);
    font-weight: 400;
    font-style: normal;
    line-height: 1.55;
    text-wrap: balance;
    color: var(--if-ink);
  }

  .quote-section__by {
    margin-top: 18px;
    font-family: var(--if-font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--if-gold-ink);
  }
</style>
