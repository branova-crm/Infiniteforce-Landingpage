---
import VideoTestimonials from '../ui/VideoTestimonials.astro';
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { stories } = getHome(resolveLocale(Astro.props.locale));
---

<section id="stories" class="stories-section grain section-pad on-light" aria-labelledby="stories-title">
  <div class="container-x">
    <div class="mx-auto max-w-[40rem] text-center" data-reveal>
      <p class="eyebrow eyebrow--center">{stories.eyebrow}</p>
      <h2 id="stories-title" class="headline mt-6 text-[clamp(34px,4.6vw,58px)] text-ink">
        {stories.title}
      </h2>
      <p class="lead mx-auto mt-5 max-w-[32rem] text-ink-soft">{stories.lead}</p>
    </div>

    <div class="mt-14" data-reveal style="--reveal-delay:80ms">
      <VideoTestimonials items={stories.items} playLabel={stories.play} />
    </div>
  </div>
</section>

<style>
  .stories-section {
    background: #ffffff;
  }
</style>
