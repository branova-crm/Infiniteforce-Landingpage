---
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { fit } = getHome(resolveLocale(Astro.props.locale));
---

<section class="surface-ivory grain section-pad on-light" aria-labelledby="fit-title">
  <div class="container-x">
    <div class="text-center" data-reveal>
      <p class="eyebrow eyebrow--center">{fit.eyebrow}</p>
      <h2 id="fit-title" class="display mt-8 text-[clamp(34px,4.6vw,64px)] text-ink">{fit.title}</h2>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:gap-10">
      <div class="card-light p-[clamp(26px,4vw,48px)]" data-reveal>
        <p class="display-italic text-[clamp(26px,2.6vw,34px)] text-gold-ink">{fit.yesTitle}</p>
        <ul class="mt-8 space-y-5">
          {
            fit.yes.map((line) => (
              <li class="flex gap-4 text-[15px] leading-relaxed text-ink">
                <svg class="mt-1.5 shrink-0 text-gold-deep" width="14" height="12" viewBox="0 0 14 12" aria-hidden="true">
                  <path d="M1 6.5l4 4L13 1.5" fill="none" stroke="currentColor" stroke-width="1.3" />
                </svg>
                {line}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="p-[clamp(26px,4vw,48px)] ring-1 ring-ink/12" data-reveal style="--reveal-delay:100ms">
        <p class="display-italic text-[clamp(26px,2.6vw,34px)] text-ink/60">{fit.noTitle}</p>
        <ul class="mt-8 space-y-5">
          {
            fit.no.map((line) => (
              <li class="flex gap-4 text-[15px] leading-relaxed text-ink/65">
                <svg class="mt-1.5 shrink-0" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1" />
                </svg>
                {line}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
