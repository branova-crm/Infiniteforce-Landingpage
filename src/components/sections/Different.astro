---
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { different } = getHome(resolveLocale(Astro.props.locale));
---

<section class="surface-dark section-pad" aria-labelledby="different-title">
  <div class="container-x">
    <div class="mx-auto max-w-[56rem] text-center" data-reveal>
      <p class="eyebrow eyebrow--center">{different.eyebrow}</p>
      <h2 id="different-title" class="display mt-8 text-[clamp(34px,4.8vw,68px)] text-ivory">{different.title}</h2>
      <div class="mx-auto mt-8 max-w-[40rem] space-y-3">
        {different.beliefs.map((p) => <p class="lead text-mist">{p}</p>)}
      </div>
      <p class="display-italic mx-auto mt-10 max-w-[34ch] text-[clamp(22px,2.4vw,30px)] leading-snug text-cream">
        {different.connectLead}
      </p>
    </div>

    <ul class="mt-14 grid grid-cols-1 gap-px bg-gold/25 sm:grid-cols-2 lg:grid-cols-5" data-reveal>
      {
        different.pairs.map((pair) => (
          <li class="bg-black-if px-5 py-8 text-center font-display text-[clamp(19px,1.7vw,23px)] text-gold-light italic">{pair}</li>
        ))
      }
    </ul>

    <div class="mt-16 grid gap-10 md:grid-cols-2" data-reveal>
      {
        different.founders.map((line) => (
          <p class="border-l border-gold/50 pl-6 text-[16px] leading-relaxed text-ivory">{line}</p>
        ))
      }
    </div>
    <p class="body-copy mx-auto mt-10 max-w-[48rem] text-center text-mist" data-reveal>{different.program}</p>
    <div class="mt-10 space-y-1 text-center" data-reveal>
      {
        different.balance.map((line, i) => (
          <p class:list={[i === 2 ? 'display mt-4 text-[clamp(24px,2.6vw,34px)] text-gold-light' : 'lead text-cream']}>{line}</p>
        ))
      }
    </div>

    <div class="mt-28 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <h3 class="display text-[clamp(32px,4vw,56px)] text-ivory">{different.workTitle}</h3>
        <ul class="mt-8 space-y-1">
          {different.workLead.map((line) => <li class="display-italic text-[clamp(22px,2.2vw,28px)] text-gold-light">{line}</li>)}
        </ul>
      </div>
      <ul class="lg:col-span-7" data-reveal style="--reveal-delay:100ms">
        {
          different.sothat.map((line) => (
            <li class="flex gap-5 border-b border-gold/15 py-5">
              <span class="mt-2 h-px w-6 shrink-0 bg-gold" aria-hidden="true" />
              <span class="text-[16px] leading-relaxed text-ivory">{line}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="mt-24 flex flex-col items-center justify-center gap-2 md:flex-row md:gap-10" data-reveal>
      {different.triad.map((word) => <li class="display gold-text text-[clamp(36px,5vw,72px)]">{word}</li>)}
    </ul>
  </div>
</section>
