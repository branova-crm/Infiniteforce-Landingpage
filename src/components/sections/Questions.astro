---
import { site } from '../../config/site';
import { resolveLocale, type Locale } from '../../i18n/config';
import { getHome } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale);
const { questions: q } = getHome(locale);
const privacyHref = locale === 'en' ? site.legal.privacyEn : site.legal.privacy;

const fields = [
  { name: 'name', label: q.name, type: 'text', autocomplete: 'name', placeholder: q.namePh },
  { name: 'telefon', label: q.phone, type: 'tel', autocomplete: 'tel', placeholder: q.phonePh },
  { name: 'email', label: q.email, type: 'email', autocomplete: 'email', placeholder: q.emailPh },
];
---

<section id="questions" class="surface-cream grain section-pad on-light" aria-labelledby="questions-title">
  <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5" data-reveal>
      <p class="eyebrow">{q.eyebrow}</p>
      <h2 id="questions-title" class="display mt-8 text-[clamp(34px,4.2vw,58px)] text-ink">{q.title}</h2>
      <p class="lead mt-6 max-w-[30rem]">{q.lead}</p>
    </div>

    <form
      class="card-light p-[clamp(24px,4vw,48px)] lg:col-span-7"
      data-questions-form
      data-endpoint={site.form.endpoint}
      novalidate
      data-reveal
      style="--reveal-delay:100ms"
    >
      <div class="grid gap-5 sm:grid-cols-2" data-fields>
        {
          fields.map((f) => (
            <label class:list={['block', f.name === 'name' && 'sm:col-span-2']}>
              <span class="label-caps mb-2 block text-[10px] text-ink">{f.label}</span>
              <input
                name={f.name}
                type={f.type}
                autocomplete={f.autocomplete}
                required
                placeholder={f.placeholder}
                class="field"
              />
              <span class="mt-1.5 block text-[12px] text-error" data-err={f.name} hidden />
            </label>
          ))
        }

        <label class="block sm:col-span-2">
          <span class="label-caps mb-2 block text-[10px] text-ink">{q.message}</span>
          <textarea name="message" rows="5" required placeholder={q.messagePh} class="field resize-y"></textarea>
          <span class="mt-1.5 block text-[12px] text-error" data-err="message" hidden></span>
        </label>

        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          class="absolute -left-[9999px] h-0 w-0 opacity-0"
          aria-hidden="true"
        />

        <p class="text-[12px] leading-relaxed text-ink-soft sm:col-span-2">
          {q.consentBefore}{' '}
          <a href={privacyHref} class="text-gold-ink underline underline-offset-2 hover:text-ink">{q.consentLink}</a>
          {q.consentAfter}
        </p>

        <button type="submit" class="btn btn-ink btn-block sm:col-span-2" data-submit>{q.submit}</button>
        <p class="text-center text-[13px] text-error sm:col-span-2" data-form-error hidden></p>
      </div>

      <div class="py-10 text-center" data-success hidden>
        <p class="display-italic text-[32px] text-gold-ink">{q.successTitle}</p>
        <p class="body-copy mt-3">{q.successBody}</p>
      </div>
    </form>
  </div>
</section>

<script
  define:vars={{
    errName: q.errName,
    errPhone: q.errPhone,
    errPhoneInvalid: q.errPhoneInvalid,
    errEmail: q.errEmail,
    errEmailInvalid: q.errEmailInvalid,
    errMessage: q.errMessage,
    errNetwork: q.errNetwork,
    submitting: q.submitting,
    submitLabel: q.submit,
  }}
>
  const form = document.querySelector('[data-questions-form]');
  if (form instanceof HTMLFormElement) {
    const endpoint = form.dataset.endpoint || '/api/register';
    const submitBtn = form.querySelector('[data-submit]');
    const success = form.querySelector('[data-success]');
    const formError = form.querySelector('[data-form-error]');
    const fields = form.querySelector('[data-fields]');

    const showErr = (name, msg) => {
      const el = form.querySelector(`[data-err="${name}"]`);
      const input = form.querySelector(`[name="${name}"]`);
      if (el instanceof HTMLElement) {
        el.textContent = msg;
        el.hidden = !msg;
      }
      if (input instanceof HTMLElement) {
        if (msg) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
      }
    };

    const clearErrs = () => {
      ['name', 'telefon', 'email', 'message'].forEach((n) => showErr(n, ''));
      if (formError instanceof HTMLElement) formError.hidden = true;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrs();

      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const telefon = String(data.get('telefon') || '').trim();
      const email = String(data.get('email') || '').trim();
      const message = String(data.get('message') || '').trim();
      const website = String(data.get('website') || '').trim();

      let ok = true;
      if (name.length < 2) {
        showErr('name', errName);
        ok = false;
      }
      const digits = telefon.replace(/\D/g, '');
      if (!telefon) {
        showErr('telefon', errPhone);
        ok = false;
      } else if (digits.length < 6) {
        showErr('telefon', errPhoneInvalid);
        ok = false;
      }
      if (!email) {
        showErr('email', errEmail);
        ok = false;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        showErr('email', errEmailInvalid);
        ok = false;
      }
      if (message.length < 5) {
        showErr('message', errMessage);
        ok = false;
      }
      if (!ok) {
        form.querySelector('[aria-invalid="true"]')?.focus();
        return;
      }

      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
        submitBtn.textContent = submitting;
      }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ name, telefon, email, message, website, type: 'question' }),
        });
        if (!response.ok) throw new Error('fail');
        if (fields instanceof HTMLElement) fields.hidden = true;
        if (success instanceof HTMLElement) success.hidden = false;
      } catch {
        if (formError instanceof HTMLElement) {
          formError.textContent = errNetwork;
          formError.hidden = false;
        }
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitLabel;
        }
      }
    });
  }
</script>
