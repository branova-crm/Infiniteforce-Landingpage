---
import { Image } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import WebinarDetails from './WebinarDetails.astro';
import { webinar } from '../config/webinar';
import { resolveLocale, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';
import goekhanImg from '../assets/images/goekhan-baylan.jpg';
import patriciaImg from '../assets/images/patricia-baylan.jpg';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale);
const copy = getUi(locale);
const { goekhan, patricia } = webinar.speakers;
---

<section id="anmeldung" aria-labelledby="anmeldung-title" class="register-bg relative border-t border-primary/20 px-5 py-[clamp(52px,7vw,104px)]">
  <div class="mx-auto flex max-w-[720px] flex-col items-center text-center">
    <p class="m-0 mb-3 text-[12px] font-extrabold tracking-[0.18em] text-primary-text uppercase">{copy.registerEyebrow}</p>
    <h2 id="anmeldung-title" class="m-0 mb-3 text-[length:clamp(30px,3.8vw,48px)] leading-[1.04] font-black tracking-[-0.02em] text-balance text-ink uppercase">
      {copy.registerTitleBefore}{' '}
      <span class="text-shine-gold text-primary-text" data-shine={copy.registerTitleAccent}>
        <span class="text-shine-gold__label">{copy.registerTitleAccent}</span>
      </span>
    </h2>
    <p class="m-0 mb-7 max-w-[460px] text-[16px] leading-[1.6] text-body">{copy.registerLead}</p>
    <WebinarDetails locale={locale} cellClass="bg-white text-ink" labelClass="text-primary-text" class="mb-8 w-full max-w-[460px] text-left" />
    <CtaButton shine label={copy.ctaLabel} class="btn-hero box-border w-full max-w-[520px] px-6 py-[11px] text-center text-[length:clamp(16px,2vw,20px)]" />
    <div class="mt-6 flex items-center justify-center gap-3">
      <div class="flex shrink-0">
        <Image src={goekhanImg} alt="" width={80} height={80} class="block h-10 w-10 rounded-full border-2 border-primary-deep object-cover object-[center_25%]" />
        <Image src={patriciaImg} alt="" width={80} height={80} class="-ml-2.5 block h-10 w-10 rounded-full border-2 border-primary-deep object-cover object-[center_20%]" />
      </div>
      <p class="m-0 text-[14px] leading-[1.45] text-ink-soft">{copy.registerWith} {goekhan.name} &amp; {patricia.name}</p>
    </div>
  </div>
</section>
