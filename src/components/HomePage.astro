---
/**
 * Infiniteforce Hauptseite – kompakter Funnel DE/EN.
 */
import Layout from '../layouts/Layout.astro';
import AnnouncementBar from './AnnouncementBar.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Product from './sections/Product.astro';
import Principles from './sections/Principles.astro';
import Problem from './sections/Problem.astro';
import VoiceSection from './sections/VoiceSection.astro';
import Stories from './sections/Stories.astro';
import Quote from './sections/Quote.astro';
import Offer from './sections/Offer.astro';
import FaqSection from './sections/FaqSection.astro';
import FinalCta from './sections/FinalCta.astro';
import Questions from './sections/Questions.astro';
import Footer from './Footer.astro';
import StickyCTA from './StickyCTA.astro';
import ScrollProgress from './ui/ScrollProgress.astro';
import ExitIntent from './ui/ExitIntent.astro';
import { resolveLocale, type Locale } from '../i18n/config';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale);
---

<Layout locale={locale}>
  <ScrollProgress />
  <AnnouncementBar locale={locale} />
  <Header locale={locale} />
  <main>
    <Hero locale={locale} />
    <Product locale={locale} />
    <Principles locale={locale} />
    <Problem locale={locale} />
    <Stories locale={locale} />
    <Quote locale={locale} />
    <VoiceSection locale={locale} />
    <Offer locale={locale} />
    <FaqSection locale={locale} />
    <FinalCta locale={locale} />
    <Questions locale={locale} />
  </main>
  <Footer locale={locale} />
  <StickyCTA locale={locale} />
  <ExitIntent locale={locale} />
</Layout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (!reduce && 'IntersectionObserver' in window && targets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );

    targets.forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('is-visible');
      io.observe(el);
    });
    document.documentElement.classList.add('reveal-ready');
  }
</script>
