---
import { webinar } from '../config/webinar';
import { resolveLocale, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale);
const copy = getUi(locale);
---

<dialog
  data-registration-dialog
  aria-labelledby="anmeldung-dialog-title"
  class="registration-dialog m-auto w-[min(440px,calc(100vw-32px))] max-w-none border-0 bg-transparent p-0 text-ink"
>
  <div class="relative overflow-hidden rounded-card border border-primary-deep/30 bg-white px-6 pt-7 pb-6 shadow-[0_24px_60px_rgba(16,12,4,0.28)] min-[480px]:px-8 min-[480px]:pt-8 min-[480px]:pb-7">
    <button
      type="button"
      data-registration-close
      aria-label={copy.modalClose}
      class="absolute top-3.5 right-3.5 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-[22px] leading-none text-body transition-colors hover:bg-light hover:text-ink"
    >
      ×
    </button>

    <form
      data-registration-form
      data-endpoint={webinar.form.endpoint}
      data-submitting-label={copy.ctaSubmitting}
      data-err-name={copy.errName}
      data-err-telefon={copy.errPhone}
      data-err-telefon-invalid={copy.errPhoneInvalid}
      data-err-email={copy.errEmail}
      data-err-email-invalid={copy.errEmailInvalid}
      data-err-network={copy.errNetwork}
      novalidate
      aria-label={copy.registerEyebrow}
      class="relative flex flex-col gap-3.5"
    >
      <p class="m-0 text-[11px] font-extrabold tracking-[0.16em] text-primary-text uppercase">{copy.modalEyebrow}</p>
      <h2 id="anmeldung-dialog-title" class="m-0 text-[length:clamp(26px,5vw,34px)] leading-[1.08] font-black tracking-[-0.02em] text-balance uppercase">
        {copy.modalTitleBefore}{' '}
        <span class="text-primary-text">{copy.modalTitleAccent}</span>
      </h2>
      <p class="m-0 mb-1 text-[15px] leading-[1.5] text-body">{copy.modalLead}</p>

      <div class="flex flex-col gap-1.5">
        <label for="wb-name" class="text-[13px] font-bold">{copy.modalName}</label>
        <input id="wb-name" name="name" type="text" autocomplete="name" required aria-describedby="err-name" placeholder={copy.modalNamePlaceholder} class="input-field" />
        <p id="err-name" data-error-for="name" class="m-0 text-[12px] font-semibold text-error" hidden></p>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="wb-telefon" class="text-[13px] font-bold">{copy.modalPhone}</label>
        <input id="wb-telefon" name="telefon" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby="err-telefon" placeholder={copy.modalPhonePlaceholder} class="input-field" />
        <p id="err-telefon" data-error-for="telefon" class="m-0 text-[12px] font-semibold text-error" hidden></p>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="wb-email" class="text-[13px] font-bold">{copy.modalEmail}</label>
        <input id="wb-email" name="email" type="email" inputmode="email" autocomplete="email" required aria-describedby="err-email" placeholder={copy.modalEmailPlaceholder} class="input-field" />
        <p id="err-email" data-error-for="email" class="m-0 text-[12px] font-semibold text-error" hidden></p>
      </div>

      <div aria-hidden="true" class="absolute left-[-9999px] h-px w-px overflow-hidden opacity-0">
        <label for="wb-website">Website</label>
        <input id="wb-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" data-submit class="btn-primary btn-shine mt-1 w-full cursor-pointer border-none px-5 py-[17px] text-[15px]">{copy.ctaSubmit}</button>
      <p data-form-error role="alert" class="m-0 text-center text-[12.5px] leading-[1.5] font-semibold text-error" hidden></p>
      <p class="m-0 text-center text-[12px] leading-[1.5] text-body">
        {copy.modalConsentBefore}{' '}
        <a href={locale === 'en' ? webinar.legal.privacyEn : webinar.legal.privacy} class="text-primary-text underline underline-offset-3 hover:text-ink">{copy.modalConsentLink}</a>
        {' '}{copy.modalConsentAfter}
      </p>
    </form>

    <div data-registration-success role="status" class="flex flex-col items-center gap-3 py-2 text-center" hidden>
      <div aria-hidden="true" class="gold-fill flex h-[58px] w-[58px] items-center justify-center rounded-full text-[26px] font-black shadow-[0_8px_24px_rgba(201,149,69,0.3)]">✓</div>
      <p class="m-0 mt-1 text-[11px] font-extrabold tracking-[0.16em] text-primary-text uppercase">{copy.modalSuccessEyebrow}</p>
      <h3 class="m-0 font-serif text-[length:clamp(30px,6vw,42px)] leading-[1.05] font-normal tracking-[-0.01em] italic">{copy.modalSuccessTitle} <span data-success-name></span>.</h3>
      <p class="m-0 max-w-[340px] text-[14px] leading-[1.6] text-body">
        {copy.modalSuccessBodyBefore}{' '}
        <strong data-success-email class="text-ink [overflow-wrap:anywhere]"></strong>{copy.modalSuccessBodyAfter}
      </p>
      <p class="m-0 mt-1 rounded-tile border border-primary/28 bg-light px-[18px] py-3 text-[14px] leading-[1.5] font-bold">{webinar.date} · {webinar.time}</p>
      <button type="button" data-registration-close class="btn-primary mt-2 cursor-pointer border-none px-8 py-3.5 text-[14px]">{copy.modalCloseButton}</button>
    </div>
  </div>
</dialog>

<script>
  import { submitRegistration } from '../lib/registration';

  const dialog = document.querySelector<HTMLDialogElement>('[data-registration-dialog]');
  const form = document.querySelector<HTMLFormElement>('[data-registration-form]');
  const success = document.querySelector<HTMLElement>('[data-registration-success]');

  if (dialog && form && success) {
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit]');
    const formError = form.querySelector<HTMLElement>('[data-form-error]');
    const submitLabel = submitButton?.textContent ?? '';
    const submittingLabel = form.dataset.submittingLabel ?? submitLabel;
    const fieldNames = ['name', 'telefon', 'email'] as const;

    const messages = {
      name: form.dataset.errName ?? '',
      telefon: form.dataset.errTelefon ?? '',
      telefonInvalid: form.dataset.errTelefonInvalid ?? '',
      email: form.dataset.errEmail ?? '',
      emailInvalid: form.dataset.errEmailInvalid ?? '',
      network: form.dataset.errNetwork ?? '',
    };

    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | null;

    const setError = (name: string, message: string | null) => {
      const errorEl = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (errorEl) {
        errorEl.textContent = message ?? '';
        errorEl.hidden = !message;
      }
      const input = field(name);
      if (input) {
        if (message) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
      }
    };

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      document.body.style.overflow = 'hidden';
      document.dispatchEvent(new CustomEvent('webinar:modal', { detail: { open: true } }));
      if (!form.hidden) window.setTimeout(() => field('name')?.focus(), 40);
    };

    const close = () => {
      if (!dialog.open) return;
      dialog.close();
    };

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      document.dispatchEvent(new CustomEvent('webinar:modal', { detail: { open: false } }));
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-open-registration]');
      if (trigger) {
        event.preventDefault();
        open();
      }
      if ((event.target as HTMLElement | null)?.closest('[data-registration-close]')) close();
    });

    if (window.location.hash === '#anmeldung') open();
    window.addEventListener('hashchange', () => {
      if (window.location.hash === '#anmeldung') open();
    });

    form.addEventListener('input', (event) => {
      const target = event.target as HTMLInputElement | null;
      if (target?.name && target.getAttribute('aria-invalid') === 'true') setError(target.name, null);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) ?? '').trim();
      const name = value('name');
      const telefon = value('telefon');
      const email = value('email');
      const website = value('website');
      const digits = telefon.replace(/\D/g, '');

      const errors: Record<string, string | null> = {
        name: name.length >= 2 ? null : messages.name,
        telefon: !telefon ? messages.telefon : digits.length >= 6 ? null : messages.telefonInvalid,
        email: !email ? messages.email : /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email) ? null : messages.emailInvalid,
      };
      Object.entries(errors).forEach(([fieldName, message]) => setError(fieldName, message));

      const firstInvalid = fieldNames.find((fieldName) => errors[fieldName]);
      if (firstInvalid) {
        field(firstInvalid)?.focus();
        return;
      }

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = submittingLabel;
      }
      if (formError) formError.hidden = true;

      try {
        await submitRegistration(form.dataset.endpoint ?? '', { name, telefon, email, website });

        const firstName = name.split(/\s+/)[0] ?? name;
        const nameEl = success.querySelector('[data-success-name]');
        const emailEl = success.querySelector('[data-success-email]');
        if (nameEl) nameEl.textContent = firstName;
        if (emailEl) emailEl.textContent = email;

        form.hidden = true;
        success.hidden = false;
        document.dispatchEvent(new CustomEvent('webinar:registered'));
        (success.querySelector('[data-registration-close]') as HTMLButtonElement | null)?.focus();
      } catch (error) {
        console.error(error);
        if (formError) {
          formError.textContent = messages.network;
          formError.hidden = false;
        }
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = submitLabel;
        }
      }
    });
  }
</script>
