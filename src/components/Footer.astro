---
import { webinar } from '../config/webinar';
import { resolveLocale, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale ?? Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer class="relative bg-black/65 px-5 pt-9 pb-10">
  <div class="mx-auto flex max-w-page flex-col items-center gap-[18px] text-center">
    <img src="/logos/baylan-logo-white.png" alt="BAYLAN Med. Devices" width="600" height="238" loading="lazy" class="block h-[30px] w-auto opacity-80" />
    <nav aria-label={t(locale, 'legalNav')} class="flex flex-wrap justify-center gap-x-[22px] gap-y-4 text-[12px]">
      <a href={locale === 'en' ? webinar.legal.imprintEn : webinar.legal.imprint} class="text-white/55 hover:text-white">{t(locale, 'imprint')}</a>
      <a href={locale === 'en' ? webinar.legal.privacyEn : webinar.legal.privacy} class="text-white/55 hover:text-white">{t(locale, 'privacy')}</a>
      <a href={locale === 'en' ? webinar.legal.cookiesEn : webinar.legal.cookies} class="text-white/55 hover:text-white">{t(locale, 'cookies')}</a>
    </nav>
    <p class="m-0 text-[11px] text-white/35">© {year} BAYLAN MED</p>
  </div>
</footer>
