---
import type { Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getUi(locale);

const options = [
  { code: 'de' as const, href: '/', label: copy.languageDe, short: 'DE' },
  { code: 'en' as const, href: '/en/', label: copy.languageEn, short: 'EN' },
];

const current = options.find((o) => o.code === locale) ?? options[0];
---

<div class="lang-switch" data-lang-switch>
  <button
    type="button"
    class="lang-switch__btn"
    aria-expanded="false"
    aria-haspopup="listbox"
    aria-label={copy.language}
    data-lang-trigger
  >
    <span class="lang-switch__orb" aria-hidden="true">
      {
        current.code === 'de' ? (
          <svg viewBox="0 0 24 16" width="22" height="15">
            <rect width="24" height="5.34" y="0" fill="#0a0a0a"></rect>
            <rect width="24" height="5.33" y="5.34" fill="#dd0000"></rect>
            <rect width="24" height="5.33" y="10.67" fill="#ffce00"></rect>
          </svg>
        ) : (
          <svg viewBox="0 0 24 16" width="22" height="15">
            <rect width="24" height="16" fill="#012169"></rect>
            <path d="M0 0 L24 16 M24 0 L0 16" stroke="#fff" stroke-width="3"></path>
            <path d="M0 0 L24 16 M24 0 L0 16" stroke="#C8102E" stroke-width="1.5"></path>
            <path d="M12 0 V16 M0 8 H24" stroke="#fff" stroke-width="5"></path>
            <path d="M12 0 V16 M0 8 H24" stroke="#C8102E" stroke-width="2.5"></path>
          </svg>
        )
      }
    </span>
    <span class="lang-switch__code">{current.short}</span>
    <svg class="lang-switch__caret" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
      <path d="M2.5 4.2 L6 7.8 L9.5 4.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>

  <div class="lang-switch__panel" data-lang-menu hidden>
    <p class="lang-switch__hint">{copy.language}</p>
    <ul class="lang-switch__list" role="listbox">
      {
        options.map((option) => (
          <li role="option" aria-selected={option.code === locale}>
            <a
              href={option.href}
              class:list={['lang-switch__item', { 'is-active': option.code === locale }]}
              hreflang={option.code}
              lang={option.code}
            >
              <span class="lang-switch__orb" aria-hidden="true">
                {option.code === 'de' ? (
                  <svg viewBox="0 0 24 16" width="22" height="15">
                    <rect width="24" height="5.34" y="0" fill="#0a0a0a"></rect>
                    <rect width="24" height="5.33" y="5.34" fill="#dd0000"></rect>
                    <rect width="24" height="5.33" y="10.67" fill="#ffce00"></rect>
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 16" width="22" height="15">
                    <rect width="24" height="16" fill="#012169"></rect>
                    <path d="M0 0 L24 16 M24 0 L0 16" stroke="#fff" stroke-width="3"></path>
                    <path d="M0 0 L24 16 M24 0 L0 16" stroke="#C8102E" stroke-width="1.5"></path>
                    <path d="M12 0 V16 M0 8 H24" stroke="#fff" stroke-width="5"></path>
                    <path d="M12 0 V16 M0 8 H24" stroke="#C8102E" stroke-width="2.5"></path>
                  </svg>
                )}
              </span>
              <span class="lang-switch__copy">
                <span class="lang-switch__name">{option.label}</span>
                <span class="lang-switch__short">{option.short}</span>
              </span>
              {option.code === locale && (
                <svg class="lang-switch__check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                  <path d="M3.2 8.3 L6.4 11.4 L12.8 4.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const root = document.querySelector('[data-lang-switch]');
  const trigger = root?.querySelector('[data-lang-trigger]');
  const menu = root?.querySelector('[data-lang-menu]');

  if (root && trigger && menu) {
    const setOpen = (open) => {
      menu.hidden = !open;
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      root.classList.toggle('is-open', open);
    };

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(menu.hidden);
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>

<style>
  .lang-switch {
    position: relative;
    flex-shrink: 0;
  }

  .lang-switch__btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 36px;
    padding: 0 10px 0 5px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.11), rgba(255, 255, 255, 0.04));
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.92);
    cursor: pointer;
    font-family: inherit;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  .lang-switch__btn:hover {
    border-color: rgba(224, 183, 107, 0.42);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.06));
  }

  .lang-switch.is-open .lang-switch__btn {
    border-color: rgba(224, 183, 107, 0.6);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 0 0 3px rgba(224, 183, 107, 0.12);
  }

  .lang-switch__orb {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    overflow: hidden;
    background: #1a1610;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.16),
      0 2px 6px rgba(0, 0, 0, 0.35);
  }

  .lang-switch__orb svg {
    display: block;
    width: 110%;
    height: 110%;
    object-fit: cover;
  }

  .lang-switch__code {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .lang-switch__caret {
    opacity: 0.55;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .lang-switch.is-open .lang-switch__caret {
    transform: rotate(180deg);
    opacity: 1;
  }

  .lang-switch__panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 90;
    width: min(200px, calc(100vw - 32px));
    padding: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    background: rgba(16, 13, 9, 0.94);
    -webkit-backdrop-filter: blur(20px) saturate(1.15);
    backdrop-filter: blur(20px) saturate(1.15);
    box-shadow:
      0 20px 44px rgba(0, 0, 0, 0.48),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transform-origin: top right;
    animation: lang-panel-in 0.18s ease-out;
  }

  .lang-switch__hint {
    margin: 0 0 4px;
    padding: 4px 8px 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.36);
  }

  .lang-switch__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 3px;
  }

  .lang-switch__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.84);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .lang-switch__item:hover {
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }

  .lang-switch__item.is-active {
    background: linear-gradient(135deg, rgba(224, 183, 107, 0.2), rgba(201, 149, 69, 0.08));
    color: #fff;
  }

  .lang-switch__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .lang-switch__name {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .lang-switch__short {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
  }

  .lang-switch__item.is-active .lang-switch__short {
    color: rgba(224, 183, 107, 0.95);
  }

  .lang-switch__check {
    color: var(--bm-gold);
  }

  @keyframes lang-panel-in {
    from {
      opacity: 0;
      transform: translateY(-5px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-switch__panel,
    .lang-switch__caret,
    .lang-switch__btn,
    .lang-switch__item {
      animation: none;
      transition: none;
    }
  }
</style>
