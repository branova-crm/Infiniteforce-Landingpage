---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { resolveLocale, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  heading: string;
  contentHtml: string;
  backHref?: string;
}

const locale = resolveLocale(Astro.props.locale ?? Astro.currentLocale);
const { title, description, heading, contentHtml } = Astro.props;
const backHref = Astro.props.backHref ?? (locale === 'en' ? '/en/' : '/');
---

<Layout locale={locale} title={title} description={description}>
  <Header locale={locale} />
  <main class="legal-page px-5 py-12 min-[760px]:py-16">
    <article class="legal-page__card mx-auto max-w-[760px]">
      <p class="legal-page__kicker m-0 mb-3">
        <a href={backHref} class="text-primary-text hover:text-ink">{t(locale, 'legalBack')}</a>
      </p>
      <h1 class="legal-page__title m-0 mb-8">{heading}</h1>
      <div class="legal-page__body" set:html={contentHtml} />
    </article>
  </main>
  <Footer locale={locale} />
</Layout>

<style>
  .legal-page__card {
    padding: clamp(28px, 4vw, 44px);
    border: 1px solid rgba(201, 149, 69, 0.22);
    border-radius: 20px;
    background: rgba(255, 252, 246, 0.92);
    box-shadow: 0 18px 48px rgba(25, 19, 7, 0.12);
    color: #1a1610;
  }

  .legal-page__kicker {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .legal-page__kicker a {
    text-decoration: none;
  }

  .legal-page__title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.08;
    text-transform: uppercase;
  }

  .legal-page__body :global(h2) {
    margin: 2rem 0 0.75rem;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .legal-page__body :global(h3) {
    margin: 1.6rem 0 0.6rem;
    font-size: 1.05rem;
    font-weight: 800;
  }

  .legal-page__body :global(h4) {
    margin: 1.25rem 0 0.45rem;
    font-size: 0.98rem;
    font-weight: 700;
  }

  .legal-page__body :global(p),
  .legal-page__body :global(li) {
    margin: 0 0 0.85rem;
    font-size: 15px;
    line-height: 1.65;
    color: rgba(26, 22, 16, 0.86);
  }

  .legal-page__body :global(ul) {
    margin: 0 0 1rem;
    padding-left: 1.2rem;
  }

  .legal-page__body :global(a) {
    color: #8a6420;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-page__body :global(a:hover) {
    color: #1a1610;
  }

  .legal-page__body :global(strong) {
    font-weight: 800;
    color: #1a1610;
  }
</style>
