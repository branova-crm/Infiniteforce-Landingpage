---
import CtaButton from './CtaButton.astro';
import { resolveLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';

interface Props {
  locale?: Locale;
}

const copy = getHome(resolveLocale(Astro.props.locale));
const { hero } = copy;
---

<section class="hero relative overflow-hidden" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container-x relative py-[clamp(28px,4.2vw,48px)] text-center">
    <p class="eyebrow eyebrow--center">{hero.eyebrow}</p>

    <h1
      id="hero-title"
      class="headline mx-auto mt-5 max-w-[20ch] text-[clamp(30px,4.2vw,52px)]"
    >
      {hero.titleTop}
      <em class="headline-italic gold-text mt-1 block pb-1">{hero.titleAccent}</em>
    </h1>

    <div class="mx-auto mt-4 max-w-[34rem] space-y-1">
      {hero.lead.map((line) => <p class="text-[15px] leading-[1.7] text-mist md:text-[16px]">{line}</p>)}
    </div>

    <div class="mt-7 flex flex-col items-center">
      <CtaButton label={hero.ctaPrimary} data-hero-cta />
      <p class="mt-3 text-[12.5px] tracking-[0.04em] text-mist">{hero.priceLine}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, rgba(13, 10, 8, 0.55), rgba(13, 10, 8, 0.85));
  }

  .hero__glow {
    position: absolute;
    top: -18%;
    left: 50%;
    width: 70vw;
    height: 46vw;
    max-width: 860px;
    max-height: 420px;
    background: radial-gradient(ellipse, rgba(200, 164, 110, 0.16), transparent 62%);
    transform: translateX(-50%);
    pointer-events: none;
  }
</style>
