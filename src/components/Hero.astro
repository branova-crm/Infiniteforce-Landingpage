---
import CtaButton from './CtaButton.astro';
import { resolveLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';

interface Props {
  locale?: Locale;
}

const copy = getHome(resolveLocale(Astro.props.locale));
const { hero } = copy;
---

<section class="hero relative overflow-hidden" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container-x relative py-[clamp(52px,7.5vw,96px)] text-center">
    <p class="eyebrow eyebrow--center">{hero.eyebrow}</p>

    <h1 id="hero-title" class="hero__title headline mx-auto mt-5">
      <span class="hero__title-line">{hero.titleTop}</span>
      <em class="hero__title-accent headline-italic gold-text">{hero.titleAccent}</em>
    </h1>

    <div class="hero__lead mx-auto mt-5 max-w-[38rem]">
      {hero.lead.map((line) => <p>{line}</p>)}
    </div>

    <div class="mt-8 flex flex-col items-center">
      <CtaButton label={hero.ctaPrimary} class="btn-shine" data-hero-cta />
      <p class="hero__price mt-3">{hero.priceLine}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, rgba(13, 10, 8, 0.55), rgba(13, 10, 8, 0.85));
  }

  .hero__glow {
    position: absolute;
    top: -18%;
    left: 50%;
    width: 70vw;
    height: 46vw;
    max-width: 860px;
    max-height: 420px;
    background: radial-gradient(ellipse, rgba(200, 164, 110, 0.16), transparent 62%);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.06em;
    max-width: min(920px, 100%);
    font-size: clamp(30px, 4.6vw, 58px);
    line-height: 1.12;
    color: #ffffff;
  }

  .hero__title-line,
  .hero__title-accent {
    display: block;
  }

  .hero__title-accent {
    padding-bottom: 0.06em;
  }

  @media (min-width: 720px) {
    .hero__title-line,
    .hero__title-accent {
      white-space: nowrap;
    }
  }

  .hero__lead {
    font-family: var(--if-font-sans);
    font-size: clamp(17px, 1.4vw, 19px);
    font-weight: 400;
    line-height: 1.65;
    color: #ffffff;
  }

  .hero__lead p + p {
    margin-top: 0.15em;
  }

  .hero__price {
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.72);
  }
</style>
