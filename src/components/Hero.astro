---
import { Image } from 'astro:assets';
import CtaButton from './CtaButton.astro';
import WebinarDetails from './WebinarDetails.astro';
import { webinar } from '../config/webinar';
import { resolveLocale, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';
import duo from '../assets/images/baylan-duo.jpg';

interface Props {
  locale?: Locale;
}

const locale = resolveLocale(Astro.props.locale);
const copy = getUi(locale);
const { goekhan, patricia } = webinar.speakers;
const [slam1, slam2, slam3] = copy.heroSlam;
---

<section aria-labelledby="hero-title" class="hero-bg relative overflow-hidden">
  <div class="mx-auto flex max-w-page flex-wrap items-center gap-[clamp(32px,5vw,72px)] px-5 pt-[clamp(28px,6vw,84px)] pb-[clamp(36px,5vw,72px)]">
    <div class="min-w-0 flex-[1_1_480px]">
      {
        webinar.showCongressLabel && (
          <p class="m-0 mb-[18px] inline-flex items-center gap-[9px] rounded-full border border-primary/35 bg-primary/8 px-[13px] py-[7px] text-[12px] leading-[1.3] font-bold text-white/88">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            {copy.heroEyebrow}
          </p>
        )
      }
      <p class="m-0 mb-3.5 text-[12px] font-extrabold tracking-[0.18em] text-primary uppercase">{copy.heroKicker}</p>
      <h1 id="hero-title" class="m-0 mb-5 text-[length:clamp(36px,5.2vw,64px)] leading-[1.02] font-black tracking-[-0.02em] text-balance uppercase">
        {copy.heroTitleBefore}{' '}
        <span class="hero-slam">
          <span class="hero-slam__word hero-slam__word--1 text-shine-gold" data-shine={slam1}>
            <span class="text-shine-gold__label">{slam1}</span>
          </span>{' '}
          <span class="hero-slam__word hero-slam__word--2 text-shine-gold" data-shine={slam2}>
            <span class="text-shine-gold__label">{slam2}</span>
          </span>{' '}
          <span class="hero-slam__word hero-slam__word--3 text-shine-gold" data-shine={slam3}>
            <span class="text-shine-gold__label">{slam3}</span>
          </span>
        </span>
      </h1>
      <p class="m-0 mb-[26px] max-w-[540px] text-[length:clamp(16px,1.4vw,18px)] leading-[1.6] text-pretty text-white/90">{copy.heroLead}</p>
      <WebinarDetails locale={locale} cellClass="bg-surface-cell" class="mb-6 w-full" />
      <CtaButton shine label={copy.ctaLabel} data-hero-cta class="btn-hero box-border w-full px-6 py-[11px] text-center text-[length:clamp(16px,2vw,20px)]" />
      <p class="m-0 mt-3 w-full text-center text-[12px] leading-[1.5] text-white/65">{copy.ctaHeroNote}</p>
    </div>

    <div class="mx-auto min-w-0 max-w-[450px] flex-[1_1_320px]">
      <div class="relative aspect-[4/5] overflow-hidden rounded-card border border-primary/25 bg-surface">
        <Image
          src={duo}
          alt={`${goekhan.name} ${copy.heroAnd} ${patricia.name}`}
          widths={[450, 675, 900]}
          sizes="(min-width: 490px) 450px, calc(100vw - 40px)"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 block h-full w-full object-cover object-[center_30%]"
        />
        <div class="photo-fade pointer-events-none absolute inset-0"></div>
        <div class="glass-card absolute right-3.5 bottom-3.5 left-3.5 z-2 flex flex-col items-center gap-[5px] rounded-glass px-[18px] py-[15px] text-center">
          <span class="text-[11px] font-extrabold tracking-[0.16em] text-primary uppercase">{copy.heroWith}</span>
          <span class="text-[15px] leading-[1.35] font-extrabold text-white">{goekhan.name} &amp; {patricia.name}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-marquee border-t border-primary/20 bg-background-deep/35">
    <div class="hero-marquee__track" aria-hidden="true">
      {
        [0, 1].map(() => (
          <p class="hero-marquee__group my-0 flex shrink-0 items-center gap-[clamp(28px,5vw,56px)] px-[clamp(14px,2.5vw,28px)] py-4 text-[length:clamp(12px,1.3vw,14px)] font-bold tracking-[0.22em] text-white/85 uppercase">
            <span>Mindset</span>
            <span class="text-primary-deep">·</span>
            <span>Sales</span>
            <span class="text-primary-deep">·</span>
            <span>{copy.marqueeRevenue}</span>
            <span class="text-primary-deep">·</span>
            <span>Mindset</span>
            <span class="text-primary-deep">·</span>
            <span>Sales</span>
            <span class="text-primary-deep">·</span>
            <span>{copy.marqueeRevenue}</span>
            <span class="text-primary-deep">·</span>
          </p>
        ))
      }
    </div>
    <p class="sr-only">Mindset, Sales, {copy.marqueeRevenue}</p>
  </div>
</section>

<style>
  .eyebrow-dot {
    position: relative;
    display: inline-block;
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--bm-gold);
  }

  .eyebrow-dot::before,
  .eyebrow-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--bm-gold);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .eyebrow-dot::before {
      animation: eyebrow-echo 1.8s ease-out infinite;
    }

    .eyebrow-dot::after {
      animation: eyebrow-echo 1.8s ease-out 0.9s infinite;
    }
  }

  @keyframes eyebrow-echo {
    0% {
      transform: scale(1);
      opacity: 0.65;
    }
    100% {
      transform: scale(3.4);
      opacity: 0;
    }
  }

  .hero-slam {
    display: inline;
  }

  .hero-slam__word {
    display: inline-block;
    transform-origin: center bottom;
    color: var(--bm-gold);
  }

  .hero-slam__word.text-shine-gold::after {
    animation-delay: 0.8s;
  }

  .hero-slam__word--2.text-shine-gold::after {
    animation-delay: 1s;
  }

  .hero-slam__word--3.text-shine-gold::after {
    animation-delay: 1.2s;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-slam__word--1 {
      animation: hero-slam-left 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.12s both;
    }

    .hero-slam__word--2 {
      animation: hero-slam-right 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.28s both;
    }

    .hero-slam__word--3 {
      animation: hero-slam-big 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.44s both;
    }
  }

  @keyframes hero-slam-left {
    0% {
      opacity: 0;
      transform: scale(2.4) rotate(-10deg) translateY(-0.12em);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg) translateY(0);
    }
  }

  @keyframes hero-slam-right {
    0% {
      opacity: 0;
      transform: scale(2.3) rotate(10deg) translateY(-0.1em);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg) translateY(0);
    }
  }

  @keyframes hero-slam-big {
    0% {
      opacity: 0;
      transform: scale(2.8) rotate(-6deg) translateY(-0.14em);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg) translateY(0);
    }
  }

  .hero-marquee {
    overflow: hidden;
    white-space: nowrap;
  }

  .hero-marquee__track {
    display: flex;
    width: max-content;
    animation: hero-marquee 28s linear infinite;
  }

  .hero-marquee__group {
    min-width: max-content;
  }

  @keyframes hero-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-marquee__track {
      animation: none;
      justify-content: center;
      width: 100%;
    }

    .hero-marquee__group:last-child {
      display: none;
    }
  }
</style>
