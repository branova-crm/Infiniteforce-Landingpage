---
import { resolveLocale, type Locale } from '../i18n/config';
import { getHome } from '../i18n/home';

interface Props {
  locale?: Locale;
}

const copy = getHome(resolveLocale(Astro.props.locale));
---

<a href="#offer" class="announce">
  <span class="hidden md:inline">{copy.announce.desktop}</span>
  <span class="md:hidden">{copy.announce.mobile}</span>
  <span class="announce__cta">{copy.announce.cta} →</span>
</a>

<style>
  .announce {
    position: relative;
    z-index: 61;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 18px;
    padding: 9px 20px;
    background: linear-gradient(90deg, #b8935b, #d9bc8a 50%, #b8935b);
    color: var(--if-espresso);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-align: center;
    text-transform: uppercase;
  }

  .announce:hover {
    color: var(--if-black);
  }

  .announce__cta {
    border-bottom: 1px solid currentColor;
  }
</style>
