# SMTP (Webinar-Anmeldung) – nur in Dokploy Runtime Env / lokaler .env setzen
# WICHTIG: Passwort NIEMALS committen. Zeichen # und ' im Passwort → in .env immer in Anführungszeichen:
#   SMTP_PASSWORD="dein#pass'wort"
SMTP_HOST=mail.agenturserver.de
SMTP_PORT=587
SMTP_SECURE=false
# Alternative: SMTP_PORT=465 und SMTP_SECURE=true
SMTP_USER=noreply@baylan-med.de
SMTP_PASSWORD=
SMTP_FROM=noreply@baylan-med.de
INQUIRY_TO=office@baylan-med.com
API_PORT=3001

# Optional: erscheinen in den Anmelde-Mails (Defaults: 15.10.2026 / 20:00 Uhr)
# WEBINAR_DATE=15.10.2026
# WEBINAR_TIME=20:00 Uhr
# Absolute Site-URL für Kalender-Links in Mails
# SITE_URL=https://webinar.baylan-med.de
